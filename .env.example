# ClipIt environment template — copy to .env for local development.
# .env is gitignored; never commit real keys.
#
# Supabase project ref: <your-project-ref>
# The project URL is the API endpoint, not the dashboard URL. Find it in the
# Supabase dashboard under Project Settings > API:
#   Dashboard: https://supabase.com/dashboard/project/<your-project-ref>/settings/api
#   API URL:   https://<your-project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=

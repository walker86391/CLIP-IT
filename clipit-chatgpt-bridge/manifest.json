{
  "manifest_version": 3,
  "name": "ClipIt - AI Chatbot Local Bridge",
  "version": "1.3.1",
  "description": "Local bridge connecting the ClipIt Windows desktop app to active ChatGPT, Claude, Gemini, and Arena AI (Direct Chat) sessions via WebSocket.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://lmarena.ai/*",
    "https://arena.lmsys.org/*",
    "http://127.0.0.1:28475/*",
    "ws://127.0.0.1:28475/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://lmarena.ai/*",
        "https://arena.lmsys.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipIt Bridge Status"
  }
}
